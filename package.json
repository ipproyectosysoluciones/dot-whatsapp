{
	"name": "dot-whatsapp",
	"version": "0.1.0",
	"private": true,
	"description": "Opt-in WhatsApp bridge for the Gentle Dot assistant (prototype)",
	"type": "module",
	"packageManager": "pnpm@11.5.0",
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"start": "node src/main.ts",
		"start:env": "node --env-file=.env src/main.ts",
		"test": "vitest run --exclude test/e2e-channel-notify.test.ts",
		"test:e2e": "vitest run test/e2e-channel-notify.test.ts",
		"typecheck": "tsc --noEmit",
		"changelog": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0"
	},
	"license": "MIT",
	"dependencies": {
		"@whiskeysockets/baileys": "6.7.24",
		"pino": "^10.4.0",
		"qrcode-terminal": "^0.12.0",
		"ws": "^8.22.0"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"@types/qrcode": "^1.5.6",
		"@types/qrcode-terminal": "^0.12.2",
		"@types/ws": "^8.18.2",
		"conventional-changelog-cli": "^5.0.0",
		"qrcode": "^1.5.4",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	}
}