# dot-whatsapp environment configuration
# Copy to .env and fill in your values

# ===========================================
# REQUIRED
# ===========================================
# Comma-separated E.164 numbers (digits only, no +)
# Example: 5491112345678,5491123456789
DOT_WHATSAPP_ALLOWED_NUMBERS=

# ===========================================
# PROVIDER SELECTION
# ===========================================
# baileys (default) or meta-cloud
DOT_WHATSAPP_PROVIDER=baileys

# ===========================================
# GENTLE DOT DAEMON
# ===========================================
GENTLE_DOT_URL=ws://127.0.0.1:4317/ws
GENTLE_DOT_TOKEN_FILE=~/.gentle-dot/token

# ===========================================
# ENGRAM
# ===========================================
ENGRAM_URL=http://127.0.0.1:47821
DOT_WHATSAPP_ENGRAM_PROJECT=dot-whatsapp

# ===========================================
# FILE PATHS (auto-created with correct permissions)
# ===========================================
DOT_WHATSAPP_AUTH_DIR=~/.dot-whatsapp/auth
DOT_WHATSAPP_ADMIN_TOKEN_FILE=~/.dot-whatsapp/admin-token
DOT_WHATSAPP_ALLOWLIST_FILE=~/.dot-whatsapp/allowlist.json

# ===========================================
# ADMIN API
# ===========================================
DOT_WHATSAPP_ADMIN_PORT=4407

# ===========================================
# META CLOUD API (only when DOT_WHATSAPP_PROVIDER=meta-cloud)
# ===========================================
# DOT_WHATSAPP_META_PHONE_NUMBER_ID=
# DOT_WHATSAPP_META_TOKEN=
# DOT_WHATSAPP_META_VERIFY_TOKEN=
# DOT_WHATSAPP_META_APP_SECRET=
# DOT_WHATSAPP_META_WEBHOOK_PORT=4408
# DOT_WHATSAPP_META_WEBHOOK_HOST=0.0.0.0
# DOT_WHATSAPP_META_GRAPH_URL=https://graph.facebook.com
# DOT_WHATSAPP_META_GRAPH_VERSION=v21.0
