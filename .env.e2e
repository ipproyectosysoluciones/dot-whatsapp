# E2E test environment for dot-whatsapp
# Used by docker-compose.e2e.yml

# WhatsApp
DOT_WHATSAPP_ALLOWED_NUMBERS=5491112345678
DOT_WHATSAPP_PROVIDER=baileys
DOT_WHATSAPP_ADMIN_PORT=4407
DOT_WHATSAPP_ADMIN_TOKEN_FILE=/home/dot/.dot-whatsapp/admin-token
DOT_WHATSAPP_AUTH_DIR=/home/dot/.dot-whatsapp/auth
DOT_WHATSAPP_ALLOWLIST_FILE=/home/dot/.dot-whatsapp/allowlist.json

# Gentle Dot daemon
GENTLE_DOT_URL=ws://gentle-dot:4317/ws
GENTLE_DOT_TOKEN_FILE=/home/dot/.gentle-dot/token

# Engram
ENGRAM_URL=http://engram:47821
DOT_WHATSAPP_ENGRAM_PROJECT=dot-whatsapp
